  },
  "redirects": [
    {
      "source": "/references/http-api-messages",
      "destination": "/references/http-api"
    },
    {
      "source": "/references/http-api-stream",
      "destination": "/references/http-api"
    },
    {
      "source": "/skills/how-skills-work",
      "destination": "/tools-and-skills/how-tools-work"
    },
    {
      "source": "/skills/built-in-skills",
      "destination": "/tools-and-skills/built-in-tools"
    },
    {
      "source": "/skills/building-custom-skills",
      "destination": "/tools-and-skills/building"
    },
    {
      "source": "/skills",
      "destination": "/tools-and-skills/overview"
    },
    {
      "source": "/skills/:slug*",
      "destination": "/tools-and-skills/overview"
    },
    {
      "source": "/references/skill-manifest-schema",
      "destination": "/references/tool-manifest-schema"
    }
  ]
}

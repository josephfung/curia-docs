{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Curia",
  "logo": {
    "light": "/assets/logo-curia-wordmark-dark.svg",
    "dark": "/assets/logo-curia-wordmark-light.svg"
  },
  "theme": "mint",
  "favicon": "/assets/logo-curia-mark.svg",
  "colors": {
    "primary": "#1A6B5E",
    "light": "#478189",
    "dark": "#1A6B5E"
  },
  "background": {
    "color": {
      "light": "#F5F4F1",
      "dark": "#111111"
    }
  },
  "fonts": {
    "heading": {
      "family": "Manrope",
      "weight": 700
    },
    "body": {
      "family": "Manrope",
      "weight": 400
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://meetcuria.com",
        "icon": "globe"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/josephfung/curia",
        "icon": "github",
        "iconType": "brands"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "get-started/what-to-expect"
            ]
          },
          {
            "group": "Setup",
            "pages": [
              "get-started/installation",
              "get-started/curia-email",
              "get-started/reach-your-principal",
              "get-started/voice",
              "get-started/principal-email-calendar",
              "get-started/google-docs",
              "get-started/search-and-memory",
              "get-started/check-your-setup"
            ]
          },
          {
            "group": "Running Curia",
            "pages": [
              "get-started/secrets-vault",
              "get-started/deployment",
              "get-started/configuration",
              "get-started/health-monitoring",
              "get-started/playbooks"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/overview",
              "examples/daily-morning-briefing"
            ]
          },
          {
            "group": "Contributing",
            "pages": [
              "get-started/development"
            ]
          }
        ]
      },
      {
        "tab": "Core Concepts",
        "groups": [
          {
            "group": "Core Concepts",
            "pages": [
              "core-concepts/introduction",
              "core-concepts/architecture",
              "core-concepts/layers-model",
              "core-concepts/memory",
              "core-concepts/contacts-trust",
              "core-concepts/how-curia-refers-to-you",
              "core-concepts/autonomy",
              "core-concepts/inbox-sending",
              "core-concepts/dreaming",
              "core-concepts/scheduling",
              "core-concepts/ant-farm",
              "core-concepts/registry",
              "core-concepts/releases"
            ]
          }
        ]
      },
      {
        "tab": "Agents",
        "groups": [
          {
            "group": "Agents",
            "pages": [
              "agents/multi-agent-architecture",
              "agents/how-agents-work",
              "agents/built-in-agents",
              "agents/building-custom-agents"
            ]
          }
        ]
      },
      {
        "tab": "Tools & Skills",
        "groups": [
          {
            "group": "Tools & Skills",
            "pages": [
              "tools-and-skills/overview",
              "tools-and-skills/how-tools-work",
              "tools-and-skills/built-in-tools",
              "tools-and-skills/building",
